# MIR-690
# input
param=u_v,level=1000,resol=20
# post-process
$MIR_CONFIG_STYLE=~mir/etc/mir/style-compatible.yaml
--grid=3/3 --truncation=19 --uv2uv=true --rotation=-89/1 --v-only
# action-plan
[{"type":"filter.sh-truncate","truncation":19},{"type":"transform.sh-scalar-to-namedgrid","atlas-trans-flt":false,"atlas-trans-type":"local","invtrans":"scalar","grid":"F21"},{"type":"interpolate.grid2rotated-regular-ll","interpolation":"linear","finite-element-projection-fail":"missing-value","finite-element-validate-mesh":false,"lsm-weight-adjustment":0.2,"non-linear":["missing-if-heaviest-missing"],"pole-displacement-in-degree":1e-06,"prune-epsilon":1e-10,"solver":{"type":"multiply"},"rotation":[-89,1],"grid":[3,3],"area":[90,0,-90,357]},{"type":"filter.adjust-winds-scale-cos-latitude"},{"type":"filter.adjust-winds-directions","rotation":[-89,1]},{"type":"select.field","which":1},{"type":"save","packing":"simple"}]
# grid-plan
[{"grid":"T20"},{"grid":"T19"},{"grid":"F21"},{"grid":[3,3],"projection":{"south_pole":[1,-89],"type":"rotation"}},{"grid":[3,3],"projection":{"south_pole":[1,-89],"type":"rotation"}},{"grid":[3,3],"projection":{"south_pole":[1,-89],"type":"rotation"}},{"grid":[3,3],"projection":{"south_pole":[1,-89],"type":"rotation"}},{"grid":[3,3],"projection":{"south_pole":[1,-89],"type":"rotation"}}]
