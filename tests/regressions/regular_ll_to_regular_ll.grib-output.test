# MIR-513
# input
packingType=grid_simple.grib2
# post-process
$MIR_CONFIG_GRIB_OUTPUT=~mir/etc/mir/grib-output-ii.yaml
--grid=0.5/0.5
# action-plan
[{"type":"interpolate.grid2regular-ll","interpolation":"linear","finite-element-projection-fail":"missing-value","finite-element-validate-mesh":false,"lsm-weight-adjustment":0.2,"non-linear":["missing-if-heaviest-missing"],"pole-displacement-in-degree":0,"prune-epsilon":1e-10,"solver":{"type":"multiply"},"grid":[0.5,0.5],"area":[90,0,-90,359.5]},{"type":"save"}]
# grid-plan
[{"area":[1,0,0,1],"grid":[1,1]},{"area":[1,0,0,1],"grid":[0.5,0.5]},{"area":[1,0,0,1],"grid":[0.5,0.5]}]
# grib_get
packingType=grid_simple
edition=2
bitsPerValue=16
