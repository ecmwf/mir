# MIR-708
# input
gridType=healpix,Nside=2,orderingConvention=ring.grib2
# post-process
--grid=hn2 --interpolation=healpix-statistics
# action-plan
[{"type":"interpolate.grid2namedgrid","interpolation":"healpix-statistics","interpolation-statistics":"maximum","lsm-weight-adjustment":0.2,"non-linear":["missing-if-heaviest-missing"],"pole-displacement-in-degree":0,"prune-epsilon":1e-10,"solver":{"type":"statistics","statistics":{"type":"maximum"}},"grid":"HN2"},{"type":"save"}]
# grid-plan
[{"grid":"H2"},{"grid":"H2","order":"nested"},{"grid":"H2","order":"nested"}]
# grib_get
gridType=healpix
orderingConvention=nested
Nside=2
numberOfDataPoints=48
longitudeOfFirstGridPointInDegrees=45
