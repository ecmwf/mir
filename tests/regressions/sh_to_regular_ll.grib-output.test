# MIR-513
# input
packingType=spectral_complex.grib2
# post-process
$MIR_CONFIG_GRIB_OUTPUT=~mir/etc/mir/grib-output-ii.yaml
--grid=0.5/0.5
# action-plan
[{"type":"transform.sh-scalar-to-namedgrid","atlas-trans-flt":false,"atlas-trans-type":"local","invtrans":"scalar","grid":"F21"},{"type":"interpolate.grid2regular-ll","interpolation":"linear","finite-element-projection-fail":"missing-value","finite-element-validate-mesh":false,"lsm-weight-adjustment":0.2,"non-linear":["missing-if-heaviest-missing"],"pole-displacement-in-degree":0,"prune-epsilon":1e-10,"solver":{"type":"multiply"},"grid":[0.5,0.5],"area":[90,0,-90,359.5]},{"type":"save","packing":"ccsds"}]
# grid-plan
[{"grid":"T20"},{"grid":"F21"},{"grid":[0.5,0.5]},{"grid":[0.5,0.5]}]
# grib_get
packingType=grid_ccsds
edition=2
bitsPerValue=16
