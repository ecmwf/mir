# MIR-513
# input
packingType=spectral_complex,param=vo_d.grib1
# post-process
$MIR_CONFIG_GRIB_OUTPUT=~mir/etc/mir/grib-output-ii.yaml
--vod2uv --intgrid=none --grid=1/1 --packing=ccsds --grib-edition-conversion=true
# action-plan
[{"type":"transform.sh-vod-to-uv-regular-ll","atlas-trans-flt":false,"atlas-trans-type":"local","invtrans":"vod2uv","grid":[1,1],"area":[90,0,-90,360]},{"type":"save","packing":"ccsds","edition":2}]
# grid-plan
[{"grid":"T20"},{"grid":[1,1]},{"grid":[1,1]}]
# grib_get
packingType=grid_ccsds
edition=2
bitsPerValue=16
