# MIR-513
# input
packingType=grid_simple.grib2
# post-process
$MIR_CONFIG_GRIB_OUTPUT=~mir/etc/mir/grib-output-ii.yaml
--packing=ccsds
# action-plan
[{"type":"set","packing":"ccsds"}]
# grid-plan
[{"area":[1,0,0,1],"grid":[1,1]},{"area":[1,0,0,1],"grid":[1,1]}]
# grib_get
packingType=grid_ccsds
edition=2
bitsPerValue=16
