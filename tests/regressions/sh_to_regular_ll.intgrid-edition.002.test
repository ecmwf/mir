# MIR-513
# input
packingType=spectral_complex.grib1
# post-process
$MIR_CONFIG_GRIB_OUTPUT=~mir/etc/mir/grib-output-ii.yaml
--grid=1/1 --intgrid=none --edition=2
# action-plan
[{"type":"transform.sh-scalar-to-regular-ll","atlas-trans-flt":false,"atlas-trans-type":"local","invtrans":"scalar","grid":[1,1],"area":[90,0,-90,360]},{"type":"save","packing":"ccsds","edition":2}]
# grid-plan
[{"grid":"T20"},{"grid":[1,1]},{"grid":[1,1]}]
# grib_get
packingType=grid_ccsds
edition=2
