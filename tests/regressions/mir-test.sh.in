#!/usr/bin/env bash
# SPDX-FileCopyrightText: 1996- European Centre for Medium-Range Weather Forecasts (ECMWF)
# SPDX-License-Identifier: Apache-2.0

# Test sections (each header with optional text), other lines starting with '#' are comments:
#   # input           input (file, as is or in the data directory)
#   # post-process    options (lines starting with '$' set the environment)
#   # action-plan     reference, as --dump-action-plan-file (data directory as $tests_data_dir)
#   # grid-plan       reference, as --dump-grid-plan-file
#   # grib_get        assertions, key=value of the output (values[N]=value for the N-th value), of the first message;
#   # grib_get count=N  of the N-th message (other text after the header is a comment)
#
# MIR_TESTS_DRYRUN (quick check, if set and not 0): by dry run, the action plan only (tests expected to fail aren't checked)
#
# MIR_TESTS_MODE, how GRIB geometry is exchanged with ecCodes: legacy (default, by GRIB keys), or by gridSpec on input
# (gridspec-input), output (gridspec-output) or both (gridspec). The references are the same for every mode, and the
# output of a mode other than legacy has to be identical to the legacy's (grib_compare), so switching is transparent

set -eaux

echo "======> $1"

test_file=$1

mode=${MIR_TESTS_MODE:-legacy}
case $mode in
    legacy)          mode_env="MIR_GRIDSPEC_GRIB_INPUT=0 MIR_GRIDSPEC_GRIB_OUTPUT=0" ;;
    gridspec-input)  mode_env="MIR_GRIDSPEC_GRIB_INPUT=1 MIR_GRIDSPEC_GRIB_OUTPUT=0" ;;
    gridspec-output) mode_env="MIR_GRIDSPEC_GRIB_INPUT=0 MIR_GRIDSPEC_GRIB_OUTPUT=1" ;;
    gridspec)        mode_env="MIR_GRIDSPEC_GRIB_INPUT=1 MIR_GRIDSPEC_GRIB_OUTPUT=1" ;;
    *)               echo "MIR_TESTS_MODE: unknown mode '$mode'"; exit 1 ;;
esac

# work files, by the (unique) test name and mode (so modes can run concurrently)
t=$(basename $1).$mode

mir="$<TARGET_FILE:mir-tool>"
grib_get="$<TARGET_FILE:grib_get>"
grib_compare="$<TARGET_FILE:grib_compare>"
diff="@DIFF_TOOL@"

tests_data_dir="@MIR_TESTS_DATA_DIR@"

pwd
rm -f {action-plan,grid-plan}.${t}{,.reference} data.{in,out}.$t data.out.$t.legacy

section=
message=
input=
env=
options=
assertions=()
while IFS= read n
do
    [[ -n "$n" ]] || continue

    if [[ "$n" =~ ^#\ (input|post-process|action-plan|grid-plan|grib_get)(\ (.*))?$ ]]
    then
        section=${BASH_REMATCH[1]}
        message=count=1
        [[ ! "${BASH_REMATCH[3]}" =~ ^(count=[1-9][0-9]*)(\ |$) ]] || message=${BASH_REMATCH[1]}
        continue
    fi

    [[ ! "$n" =~ ^# ]] || continue

    case $section in
        input)         input="$n" ;;
        post-process)  if [[ $n =~ ^\$ ]]; then env="$env ${n/?}"; else options="$options $n"; fi ;;
        action-plan)   echo "$n" >> action-plan.${t}.reference ;;
        grid-plan)     echo "$n" >> grid-plan.${t}.reference ;;
        grib_get)      assertions+=("$message $n") ;;
        *)             echo "line outside of a section: $n"; exit 1 ;;
    esac
done < $1

# input
m="$input"
[[ -e "$m" ]] || m="${tests_data_dir}/$(echo $input | tr '/' '_')"
[[ -e "$m" ]] || { echo "input not found: $input"; exit 1; }
ln -sf "$m" data.in.$t

# dry run: the action plan only
dryrun=0
if [[ -n "${MIR_TESTS_DRYRUN:-}" && "${MIR_TESTS_DRYRUN}" != 0 ]]
then
    if [[ "$test_file" =~ [.]fail[.] ]]
    then
        echo "dry run: expected to fail (by execution), not checked" 1>&2
        exit 1
    fi
    dryrun=1
    rm -f grid-plan.${t}.reference
    assertions=()
fi

# post-process, dumping the plans to compare
dumps=
[[ ! -r action-plan.${t}.reference ]] || dumps="$dumps --dump-action-plan-file=action-plan.$t"
[[ ! -r grid-plan.${t}.reference ]] || dumps="$dumps --dump-grid-plan-file=grid-plan.$t"
[[ $dryrun -eq 0 ]] || dumps="$dumps --dryrun"

eval options=\"$options\"
env $env $mode_env $mir $dumps $options $(pwd)/data.in.$t $(pwd)/data.out.$t
# For some reason set -e does not trigger
[[ $? -eq 0 ]] || exit 1

checks=0

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    echo "${s%"${s##*[![:space:]]}"}"
}

if [[ -r action-plan.${t}.reference ]]
then
    sed "s|${tests_data_dir}|\$tests_data_dir|g" action-plan.$t > action-plan.$t.data
    $diff action-plan.$t.data action-plan.${t}.reference
    checks=1
fi

if [[ -r grid-plan.${t}.reference ]]
then
    $diff grid-plan.$t grid-plan.${t}.reference
    checks=1
fi

for a in ${assertions[@]+"${assertions[@]}"}
do
    message=${a%% *}
    a=${a#* }
    key=$(trim "${a%%=*}")
    value=$(trim "${a#*=}")
    if [[ $key =~ values\[([0-9]+)\] ]]
    then
        g=$($grib_get -w $message -i ${BASH_REMATCH[1]} data.out.$t)
        g="$(echo $g | tr -d '[:space:]')"
    else
        g=$($grib_get -w $message -p $key data.out.$t)
    fi
    if [[ -z "$g" ]]
    then
        echo "$key: no output message $message" 1>&2
        exit 1
    fi
    if [[ "$g" != "$value" ]]  # compares strings not floats
    then
        echo "$key ($message): expected [$value], got [$g]" 1>&2
        exit 1
    fi
    checks=1
done

# transparency: the same GRIB output as by the legacy mode
if [[ $mode != legacy && $dryrun -eq 0 && "$(head -c 4 data.out.$t)" == GRIB ]]
then
    env $env MIR_GRIDSPEC_GRIB_INPUT=0 MIR_GRIDSPEC_GRIB_OUTPUT=0 $mir $options $(pwd)/data.in.$t $(pwd)/data.out.$t.legacy
    $grib_compare data.out.$t.legacy data.out.$t
fi

if [[ $checks -ne 1 ]]
then
    echo "No assertions defined"
    exit 1
fi
